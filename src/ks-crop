  if [[ -z "${video_default}" ]] ; then
    video_default=("0:0")
  else
    video_default_patch=$(print ${video_default} | cut -c4)
    if [[ "${video_default_patch}" == ":" ]] ; then
      video_default=$(print ${video_default} | cut -c1-3)
    else
      video_default=("${video_default}")
    fi
  fi
