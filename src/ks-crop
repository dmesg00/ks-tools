#!/usr/bin/env zsh

setopt NO_NOMATCH

###############################################################
# ks-crop (ks-tools) - Crop or change aspect ratio of a video #
# Date: 25-08-2026                                            #
# Author: dmesg00                                             #
# Contact: dmesg00@duck.com                                   #
###############################################################
VERSION=("9.5")
M_DATE=("250826")

# Detect version ffmpeg for old releases
ffmpeg_version=$(ffmpeg -version 2>&1 | grep version | head -1 | cut -d " " -f 3 | cut -d "." -f 1)
ffmpeg_version=${ffmpeg_version//[^0-9]/}
ffmpeg_version=$(print ${ffmpeg_version} | cut -c 1-3)
if [[ -z "${ffmpeg_version}" ]] ; then
  video_sync=("fps_mode")
else
  if (( ${ffmpeg_version} < 5 )) 2> /dev/null ; then
    video_sync=("vsync")
  else
    video_sync=("fps_mode")
  fi
fi

# Global parameters
dirTemp=("/tmp")
listTemp=("ks-tools.list")
ksToolsTempFolder=("/tmp/ks-tools")

# Resolution and parameters
to4_3=("1920x1440")
to16_9=("1920x1080")
to5_4=("1920x1540")
toImax=("1920x1346")
v_preset=("fast")
vcodec=("libx264")
b_vcodec=("6000k")
acodec=("copy")
v_ext=("mkv")
default_lang_audio=("spa")

# Empty variables
resolution=null
modeCrop=null
inputFile=("${2}")

# Check cygwin alias (for Windows)
if [[ -f "/usr/bin/cygwin-alias.zsh" ]] ; then
  setopt ALIASES
  source "/usr/bin/cygwin-alias.zsh"
fi

# Function for check dependencies
check_dependencies() {
  which_dependence=$(which ${1})
  error_dependence=$?
  if [[ -z "${which_dependence}" ]] || (( ${error_dependence} > 0 )); then
    print ""
    print "* ks-crop (ks-tools) v${VERSION} (${M_DATE})"
    print ""
    print "* Dependency not found: ${1}"
    print ""
    exit 1
  fi 
}

# Check dependencies
dependencies=(ffmpeg grep sed grep cut head tail tr cat)
for scan_dependency in "${dependencies[@]}" ; do
  check_dependencies "${scan_dependency}"
done

# Function to remove extension from file
# Syntax: removeExtension "<text>"
removeExtension() {
  wordToConvert=${1}
  ksToolsSedFile=("${ksToolsTempFolder}/ks-tools-${RANDOM}.txt")
  mkdir -p ${ksToolsTempFolder} && chmod 777 -R ${ksToolsTempFolder} 2> /dev/null
  print "${wordToConvert}" > ${ksToolsSedFile}
  # Remove extensions
  sed -i 's/\.avi//g' "${ksToolsSedFile}" &> /dev/null
  sed -i 's/\.mp4//g' "${ksToolsSedFile}" &> /dev/null
  sed -i 's/\.mkv//g' "${ksToolsSedFile}" &> /dev/null
  sed -i 's/\.mov//g' "${ksToolsSedFile}" &> /dev/null
  sed -i 's/\.vob//g' "${ksToolsSedFile}" &> /dev/null
  sed -i 's/\.mpg//g' "${ksToolsSedFile}" &> /dev/null
  sed -i 's/\.mpeg//g' "${ksToolsSedFile}" &> /dev/null
  sed -i 's/\.wmv//g' "${ksToolsSedFile}" &> /dev/null
  sed -i 's/\.ogv//g' "${ksToolsSedFile}" &> /dev/null
  sed -i 's/\.webm//g' "${ksToolsSedFile}" &> /dev/null
  sed -i 's/\.flv//g' "${ksToolsSedFile}" &> /dev/null
  # Show file without extension
  wordToConvert=$(cat ${ksToolsSedFile})
  print ${wordToConvert}
}

# Function to show files with spaces.
# Syntax: showFileWithSpace <file number>
showFileWithSpace() {
  print "${1}" > ${dirTemp}/name.tmp
  sed -i 's/_/ /g' ${dirTemp}/name.tmp 2> /dev/null
  DisplayName=$(cat ${dirTemp}/name.tmp)
  rm -rf ${dirTemp}/name.tmp
  print ${DisplayName}
}

# Function to show menu again when syntax is wrong
show_menu() {
  print ""
  print "* ks-crop (ks-tools) v${VERSION} (${M_DATE})"
  print ""
  print "\- Crop or change aspect ratio of a video"
  print ""
  print "+ Config:"
  print ""
  print " - Resolutions: "
  print "    + ${to4_3} (4:3)"
  print "    + ${to16_9} (16:9)"
  print "    + ${to5_4} (5:4)"
  print "    + ${toImax} (IMAX)"
  print " - Video codec: ${vcodec}"
  print " - Bitrate video: ${b_vcodec}"
  print " - Preset: ${v_preset}"
  print " - Audio codec: ${acodec}"
  print " - Default Audio: ${default_lang_audio}"
  print " - Container: ${v_ext}"
  print ""
  print "+ Syntax: "
  print ""
  print "  $ ks-crop -16:9-crop <video-file>   --> Crop from 4:3/IMAX to 16:9 (1.77:1)"
  print "  $ ks-crop -4:3-crop <video-file>    --> Crop from 16:9 to 4:3 (1.33:1)"
  print "  $ ks-crop -5:4-crop <video-file>    --> Crop from 16:9 to 5:4 (1.25:1)"
  print "  $ ks-crop -imax-crop <video-file>   --> Crop from 16:9 to IMAX (1.43:1)"
  print ""
  print "  $ ks-crop -16:9-aspect <video-file> --> Change aspect to 16:9 (stretched)"
  print "  $ ks-crop -4:3-aspect <video-file>  --> Change aspect to 4:3 (stretched)"
  print "  $ ks-crop -5:4-aspect <video-file>  --> Change aspect to 5:4 (stretched)"
  print ""
  print " + Examples: "
  print "    ks-crop -16:9-crop /data/movies/Example.mkv"
  print "    ks-crop -4:3-aspect /data/movies/Video.avi"
  print ""
  print " + Example with folder: "
  print '    for i in $(ls -1 /<folder>/*) ; do echo -e "\n\n\n\n\n" | ks-crop -16:9-crop $i; done'
  print ""
  exit
}

# Function to show error reading file
# Syntax: errorReadingFile <file>
errorReadingFile() {
  print ""
  print "* ks-crop (ks-tools) v${VERSION} (${M_DATE})"
  print ""
  print "* The file '${1}' does not exist!"
  print ""
  exit
}

# Conversion parameters
