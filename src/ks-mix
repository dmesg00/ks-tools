    hevc_hdr_bt=$("${p_ffmpeg[@]}" "${2}" 2>&1 | grep Stream | tr -s " " | grep "Video:" | grep "bt2020")
    hevc_hdr_smp=$("${p_ffmpeg[@]}" "${2}" 2>&1 | grep Stream | tr -s " " | grep "Video:" | grep "smpte2084")
