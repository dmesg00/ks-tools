#!/usr/bin/env zsh

setopt NO_NOMATCH

#####################################################################
# ks-mix (ks-tools) - Extract video/audio and mix video/audio files #
# Date: 25-08-2026                                                  #
# Author: dmesg00                                                   #
# Contact: dmesg00@duck.com                                         #
#####################################################################
VERSION=("9.5")
M_DATE=("250826")

# Detect version ffmpeg for old releases
ffmpeg_version=$(ffmpeg -version 2>&1 | grep version | head -1 | cut -d " " -f 3 | cut -d "." -f 1)
ffmpeg_version=${ffmpeg_version//[^0-9]/}
ffmpeg_version=$(print ${ffmpeg_version} | cut -c 1-3)
if [[ -z "${ffmpeg_version}" ]] ; then
  video_sync=("fps_mode")
else
  if (( ${ffmpeg_version} < 5 )) 2> /dev/null ; then
    video_sync=("vsync")
  else
    video_sync=("fps_mode")
  fi
fi

# File(s) detection
current_dir=("$(pwd)")
video_file_dir=("${current_dir}/video.mkv")
audio_file_dir=("${current_dir}/audio.mka")
subs_file_dir=("${current_dir}/subs.srt")
output_file_dir=("${current_dir}/output.mkv")

# Language config
default_lang_audio=("spa")
default_lang_subt=("spa")

# Check cygwin alias (for Windows)
if [[ -f "/usr/bin/cygwin-alias.zsh" ]] ; then
  setopt ALIASES
  source "/usr/bin/cygwin-alias.zsh"
fi

# Function for check dependencies
check_dependencies() {
  which_dependence=$(which ${1})
  error_dependence=$?
  if [[ -z "${which_dependence}" ]] || (( ${error_dependence} > 0 )); then
    print ""
    print -P "* %Bks-mix%b (ks-tools) %Bv${VERSION}%b (${M_DATE})"
    print ""
    print -P "* %BDependency not found%b: %U${1}%u"
    print ""
    exit 1
  fi 
}

# Check dependencies
dependencies=(ffmpeg grep sed cut head tail tr ks-utfs)
for scan_dependency in "${dependencies[@]}" ; do
  check_dependencies "${scan_dependency}"
done

# Detect if video file exist
if [[ -f "${video_file_dir}" ]] ; then
  video_found=("FOUND")
else
  video_found=("NOT FOUND")
fi
# Detect if audio file exist
if [[ -f "${audio_file_dir}" ]] ; then
  audio_found=("FOUND")
else
  audio_found=("NOT FOUND")
fi
# Detect if audio file exist
if [[ -f "${subs_file_dir}" ]] ; then
  subs_found=("FOUND")
else
  subs_found=("NOT FOUND")
fi

# Function to show zero before numbers
zero_number() {
  if (( ${1} <= 9 )) ; then
    numberwithZero=$(print "0${1}")
  else
    numberwithZero=$(print "${1}")
  fi
  print "${numberwithZero}" | cut -c 1-2
}

# Function to show menu again when Syntax is wrong
show_menu() {
  print ""
  print -P "* %Bks-mix%b (ks-tools) %Bv${VERSION}%b (${M_DATE})"
  print ""
  print "\- Extract video/audio and mix video/audio files"
  print ""
  print -P " + %BCurrent dir%b: ${current_dir}"
  print -P " + %BVideo file%b: ${video_file_dir} %B(${video_found})%b"
  print -P " + %BAudio file%b: ${audio_file_dir} %B(${audio_found})%b"
  print -P " + %BSubs file%b: ${subs_file_dir} %B(${subs_found})%b"
  print ""
  print -P "+ %USyntax%u: "
  print ""
  print -P "  $ %Bks-mix%b -evid <video-file>  --> Extract video track"
  print -P "  $ %Bks-mix%b -ev25 <video-file>  --> Extract video track to 25 fps (H264/5 & MPEG4)"
  print -P "  $ %Bks-mix%b -evpf <video-file>  --> Extract video track & set fps (H264/5 & MPEG4)"
  print -P "  $ %Bks-mix%b -eaud <video-file>  --> Extract audio track"
  print -P "  $ %Bks-mix%b -esub <video-file>  --> Extract subtitle track (only for subrip/srt)"
  print -P "  $ %Bks-mix%b -evti <video-file>  --> Extract video from a specific hour/minute/second"
  print -P "  $ %Bks-mix%b -eati <video-file>  --> Extract audio from a specific hour/minute/second"
  print -P "  $ %Bks-mix%b -evat <video-file>  --> Extract video + audio from specific time"
  print -P "  $ %Bks-mix%b -frag <video-file>  --> Extract video + audio in specific time fragments"
  print -P "  $ %Bks-mix%b -chec <video-file>  --> Analyze tracks of video file"
  print -P "  $ %Bks-mix%b -mixf               --> Mix video and audio file"
  print -P "  $ %Bks-mix%b -mixs               --> Mix video, audio and subtitle file"
  print ""
  print -P " + %UExamples%u: "
  print -P "    %Bks-mix%b -evid /data/movies/Example.mkv"
  print -P "    %Bks-mix%b -eaud /data/movies/Example.avi"
  print ""
  exit
}

# Show menu and Syntax
if [[ -z "${1}" ]] ; then
  show_menu
elif [[ "${1}" == "-evid" ]] ; then
  # Run commands for -evid parameter
  if [[ -z "${2}" ]] ; then
    show_menu
  elif [[ -f "${2}" ]] ; then
    print ""
    print -P "+ %BVideo Tracks:%b"
    ffmpeg -i "${2}" 2>&1 | grep Stream | tr -s " " | grep "Video:" | cut -d "," -f 1
    print ""
    # Check de video track by default
    video_default=$(ffmpeg -i "${2}" 2>&1 | grep Stream | tr -s " " | grep "Video:" | cut -d " " -f 3 | cut -c2-5 | cut -d "(" -f 1 | cut -d "[" -f 1 | head -1)
    if [[ -z "${video_default}" ]] ; then
      video_default=("0:0")
    else
      video_default_patch=$(print ${video_default} | cut -c4)
      if [[ "${video_default_patch}" == ":" ]] ; then
        video_default=$(print ${video_default} | cut -c1-3)
      else
        video_default=("${video_default}")
      fi
    fi
    # Ask for video
    print -P -n "* (Default: %B${video_default}%b) Type the number of video track: " ; read video_track
    if [[ -z "${video_track}" ]] ; then
      video_track=("${video_default}")
    else
      video_track=("${video_track}")
    fi
    print ""
    print -P -n "* Starting extract video track (%B${2}%b) "
    sleep 3
    ffmpeg -y -i "${2}" -map ${video_track} -c:v copy "${current_dir}/seeing.mp4"
    ffmpeg -y -i "${current_dir}/seeing.mp4" -map 0:0 -${video_sync} cfr -c:v copy "${video_file_dir}"
    print ""
    print -P -n "* Extracted video into %U${video_file_dir}%u"
    sleep 2
    rm -rf "${current_dir}/seeing.mp4"
    print "" && print ""
    exit
  else
    print ""
    print -P "* The file %U${2}%u does not exist"
    print ""
    exit
  fi
elif [[ "${1}" == "-ev25" ]] ; then
  # Run commands for -ev25 parameter
  if [[ -z "${2}" ]] ; then
    show_menu
  elif [[ -f "${2}" ]] ; then
    print ""
    print -P "+ %BVideo Tracks:%b"
    ffmpeg -i "${2}" 2>&1 | grep Stream | tr -s " " | grep "Video:" | cut -d "," -f 1
