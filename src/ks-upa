# Function to check local and server checksum.
# Syntax: checkChecksum <password> <local file path> <user> <server> <server file path>
checkChecksum() {
  correct=0
  countChecksum=0
  print -n "Checking checksum... " && sleep 4
  print ""
  toolSelected=$(cat ${dirConfig}/ks-upload-tool | grep "rsa")
  selectedTool=$(cat ${dirConfig}/ks-upload-tool)
  portSelected=$(cat ${dirConfig}/ks-upload-port)
  while (( correct == 0 )) ; do
    if [[ "${cygwin}" == "yes" ]] ; then
      if [[ -z "${toolSelected}" ]] ; then
        if [[ "${selectedTool}" == "rsync-pem" ]] ; then
          checksumLocal=$(/usr/bin/md5sum ${2})
          checksumServer=$(/usr/bin/ssh -i ${dirConfig}/connect.pem -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
          OUTPUT=$?
        elif [[ "${selectedTool}" == "scp-pem" ]] ; then
          checksumLocal=$(md5sum ${2})
          checksumServer=$(/usr/bin/ssh -i ${dirConfig}/connect.pem -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
          OUTPUT=$?
        else
          checksumLocal=$(/usr/bin/md5sum ${2})
          checksumServer=$(/usr/bin/sshpass -p ${1} /usr/bin/ssh -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
          OUTPUT=$?
        fi
      elif [[ "${selectedTool}" == "rsync-e" ]] ; then
        print > /dev/null
        OUTPUT=0
      elif [[ "${selectedTool}" == "scp-e" ]] ; then
        print > /dev/null
        OUTPUT=0
      else
        checksumLocal=$(/usr/bin/md5sum ${2})
        checksumServer=$(/usr/bin/sshpass -p ${1} /usr/bin/ssh -o HostKeyAlgorithms=+ssh-rsa -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
        OUTPUT=$?
      fi
    else
      if [[ -z "${toolSelected}" ]] ; then
        if [[ "${selectedTool}" == "rsync-pem" ]] ; then
          checksumLocal=$(md5sum ${2})
          checksumServer=$(ssh -i ${dirConfig}/connect.pem -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
          OUTPUT=$?
        elif [[ "${selectedTool}" == "scp-pem" ]] ; then
          checksumLocal=$(md5sum ${2})
          checksumServer=$(ssh -i ${dirConfig}/connect.pem -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
          OUTPUT=$?
        else
          checksumLocal=$(md5sum ${2})
          checksumServer=$(sshpass -p ${1} /usr/bin/ssh -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
          OUTPUT=$?
        fi
      elif [[ "${selectedTool}" == "rsync-e" ]] ; then
        print > /dev/null
        OUTPUT=0
      elif [[ "${selectedTool}" == "scp-e" ]] ; then
        print > /dev/null
        OUTPUT=0
      else
        checksumLocal=$(md5sum ${2})
        checksumServer=$(sshpass -p ${1} ssh -o HostKeyAlgorithms=+ssh-rsa -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
        OUTPUT=$?
      fi
    fi
    if (( OUTPUT != 0 )) ; then
      print "Failed to get checksum for ${5}"
      print "Retrying..."
      sleep 5
      countChecksum=$(expr ${countChecksum} + 1)
      if (( countChecksum == 3 )) ; then
        correct=1
      fi
    else
      if [[ "${selectedTool}" == "rsync-e" ]] ; then
        print > /dev/null
        correct=1
      elif [[ "${selectedTool}" == "scp-e" ]] ; then
        print > /dev/null
        correct=1
      else
      print "Local checksum: ${checksumLocal}"
      print "Server checksum: ${checksumServer}"
      correct=1
      fi
    fi
  done
}

