        elif [[ "${editUpvTool}" == "scp-pem" ]] ; then
          print "scp" > ${dirConfig}/ks-upload-tool
        fi
      fi
    elif [[ "${EDIT}" == "3" ]] ; then
      print -n "* Enter the server URL: " ; read SERVER
