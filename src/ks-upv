# Function for check dependencies
check_dependencies() {
  which_dependence=$(which ${1})
  error_dependence=$?
  if [[ -z "${which_dependence}" ]] || (( ${error_dependence} > 0 )); then
    print ""
    print -P "* Some required tools are not installed: %U${1}%u"
    print "* The process has been stopped"
    print ""
    exit 1
  fi 
}

# Check dependencies
checkDependencies() {
  print "* Checking necessary tools... "
  dependencies=(sshpass expect rsync md5sum scp ssh find grep sed cut head tail cat ssh-keyscan ssh-keygen)
  for scan_dependency in "${dependencies[@]}" ; do
    check_dependencies "${scan_dependency}"
  done
  print "* The necessary tools are installed"
}

