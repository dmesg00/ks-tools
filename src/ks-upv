      print -P "* %UNote%u: 'scp-pem' and 'rsync-pem' use ~/.ks-tools/connect.pem."
      print "" 
      print -n "* [Default: scp] Type upload tool (Example: rsync-e): " ; read TOOL
      if [[ -z "${TOOL}" ]] ; then
        upvTool=("scp")
      elif [[ "${TOOL}" == "rsync" ]] ; then
        upvTool=("rsync")
      elif [[ "${TOOL}" == "rsync-rsa" ]] ; then
        upvTool=("rsync-rsa")
      elif [[ "${TOOL}" == "scp-rsa" ]] ; then
        upvTool=("scp-rsa")
      elif [[ "${TOOL}" == "scp-e" ]] ; then
        upvTool=("scp-e")
      elif [[ "${TOOL}" == "rsync-e" ]] ; then
        upvTool=("rsync-e")
      elif [[ "${TOOL}" == "scp-pem" ]] ; then
        upvTool=("scp-pem")
      elif [[ "${TOOL}" == "rsync-pem" ]] ; then
        upvTool=("rsync-pem")
      else  
        upvTool=("scp")
      fi
      print ${upvTool} > ${dirConfig}/ks-upload-tool
    elif [[ "${EDIT}" == "7" ]] ; then
      print -n "* [Default: 22] Type port connection: " ; read PORT
      if [[ -z "${PORT}" ]] ; then
        upvPort=("22")
      else
        upvPort=("${PORT}")
      fi
      print ${upvPort} > ${dirConfig}/ks-upload-port
    elif [[ "${EDIT}" == "8" ]] ; then
      editConfig=1
    else
      print "+ Invalid option!"
      print -n "- Press ENTER to continue " ; read CONTINUE
    fi
  done
  exit
}

# Function to create initial config file.
createConfig() {
# Start script
  clear
  print ""
  print -P "* %Bks-upv%b (ks-tools) %Bv${VERSION}%b (${M_DATE})"
  print ""
  checkDependencies
  # Ask the user and if it exists, read it from the config.
  if [[ -f ${dirConfig}/ks-upload-user ]] ; then
    print -P "+ The %BUSER%b configuration already exists (Use: %Uks-upv -e%u for edit)"
  else
    print -n "* Enter the server user: " ; read USER
    user=${USER}
    print ${user} > ${dirConfig}/ks-upload-user
  fi
  # Ask the password and if it exists, read it from the config.
  if [[ -f ${dirConfig}/ks-upload-pass ]] ; then
    print -P "+ The %BPASSWORD/PEM%b configuration already exists (Use: %Uks-upv -e%u for edit)" 
  else
    print -P -n "* Enter the server password (type %Upem%u for use pem certificate): " ; read PASS
    if [[ "${PASS}" == "pem" ]] ; then
      print -n "+ Type the absolute path to the .pem file: " ; read pem_path
      if [[ -f "${pem_path}" ]] ; then
        raw_password_enter=${PASS}
        encrypt_password_enter=$(encrypt_kstools "${raw_password_enter}")
        print ${encrypt_password_enter} > ${dirConfig}/ks-upload-pass
        cp -rf "${pem_path}" ${dirConfig}/connect.pem
        chmod 600 ${dirConfig}/connect.pem
        print "scp-pem" > ${dirConfig}/ks-upload-tool
        print -P "* PEM file copied to %U${dirConfig}/connect.pem%u"
      else
        print -P "+ File %U${pem_path}%u does not exist"
        print "+ The configuration is cancelled"
        exit
      fi
    else
      raw_password_enter=${PASS}
      encrypt_password_enter=$(encrypt_kstools "${raw_password_enter}")
      print ${encrypt_password_enter} > ${dirConfig}/ks-upload-pass
    fi
  fi
  # Ask the server URL and if it exists, read it from the config.
  if [[ -f ${dirConfig}/ks-upload-server ]] ; then
    print -P "+ The %BSERVER%b configuration already exists (Use: %Uks-upv -e%u for edit)"
  else
    print -n "* Enter the server URL (or IP): " ; read SERVER
    server=${SERVER}
    print ${server} > ${dirConfig}/ks-upload-server
  fi
  # Ask the path on the server and if it exists, read it from the config.
  if [[ -f ${dirConfig}/ks-upload-dirserver ]] ; then
    print -P "+ The %BSERVER PATH%b configuration already exists (Use: %Uks-upv -e%u for edit)"
  else
    print -n "* Enter the path on the server: " ; read DIR_SERVER
    dirServer=${DIR_SERVER}
    print ${dirServer} > ${dirConfig}/ks-upload-dirserver
  fi
  # Ask the local path and if it exists, read it from the config.
  if [[ -f ${dirConfig}/ks-upload-dirlocal ]] ; then
    print -P "+ The %BLOCAL PATH%b configuration already exists (Use: %Uks-upv -e%u for edit)"
  else
    print -n "* Enter the local path to scan: " ; read DIR
    dirLocal=${DIR}
    print ${dirLocal} > ${dirConfig}/ks-upload-dirlocal
  fi
  # Configure upload tool by default
  if [[ -f ${dirConfig}/ks-upload-tool ]] ; then
    print -P "+ The %BUPLOAD TOOL%b configuration already exists (Use: %Uks-upv -e%u for edit)"
  else
    if [[ "${PASS}" == "pem" ]] ; then
      print "* Setting 'scp-pem' as the default tool"
      print "scp-pem" > ${dirConfig}/ks-upload-tool
    else
      print "* Setting 'scp' as the default tool"
      print "scp" > ${dirConfig}/ks-upload-tool
    fi
  fi
   # Configure port by default
  if [[ -f ${dirConfig}/ks-upload-port ]] ; then
    print -P "+ The %BPORT%b configuration already exists (Use: %Uks-upv -e%u for edit)"
  else
    print "* Setting port 22 as the default port"
    print "22" > ${dirConfig}/ks-upload-port
  fi
  print ""
}

