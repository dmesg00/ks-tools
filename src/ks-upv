# Function to check local and server checksum.
# Syntax: checkChecksum <password> <local file path> <user> <server> <server file path>
checkChecksum() {
  correct=0
  countChecksum=0
  print -n "Checking checksum... " && sleep 4
  print ""
  toolSelected=$(cat ${dirConfig}/ks-upload-tool | grep "rsa")
  selectedTool=$(cat ${dirConfig}/ks-upload-tool)
  portSelected=$(cat ${dirConfig}/ks-upload-port)
  while (( correct == 0 )) ; do
    if [[ "${cygwin}" == "yes" ]] ; then
      if [[ -z "${toolSelected}" ]] ; then
        if [[ "${selectedTool}" == "rsync-pem" ]] ; then
          checksumLocal=$(/usr/bin/md5sum ${2})
          checksumServer=$(/usr/bin/ssh -i ${dirConfig}/connect.pem -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
          OUTPUT=$?
        elif [[ "${selectedTool}" == "scp-pem" ]] ; then
          checksumLocal=$(md5sum ${2})
          checksumServer=$(/usr/bin/ssh -i ${dirConfig}/connect.pem -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
          OUTPUT=$?
        else
          checksumLocal=$(/usr/bin/md5sum ${2})
          checksumServer=$(/usr/bin/sshpass -p ${1} /usr/bin/ssh -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
          OUTPUT=$?
        fi
      elif [[ "${selectedTool}" == "rsync-e" ]] ; then
        print > /dev/null
        OUTPUT=0
      elif [[ "${selectedTool}" == "scp-e" ]] ; then
        print > /dev/null
        OUTPUT=0
      else
        checksumLocal=$(/usr/bin/md5sum ${2})
        checksumServer=$(/usr/bin/sshpass -p ${1} /usr/bin/ssh -o HostKeyAlgorithms=+ssh-rsa -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
        OUTPUT=$?
      fi
    else
      if [[ -z "${toolSelected}" ]] ; then
        if [[ "${selectedTool}" == "rsync-pem" ]] ; then
          checksumLocal=$(md5sum ${2})
          checksumServer=$(ssh -i ${dirConfig}/connect.pem -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
          OUTPUT=$?
        elif [[ "${selectedTool}" == "scp-pem" ]] ; then
          checksumLocal=$(md5sum ${2})
          checksumServer=$(ssh -i ${dirConfig}/connect.pem -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
          OUTPUT=$?
        else
          checksumLocal=$(md5sum ${2})
          checksumServer=$(sshpass -p ${1} /usr/bin/ssh -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
          OUTPUT=$?
        fi
      elif [[ "${selectedTool}" == "rsync-e" ]] ; then
        print > /dev/null
        OUTPUT=0
      elif [[ "${selectedTool}" == "scp-e" ]] ; then
        print > /dev/null
        OUTPUT=0
      else
        checksumLocal=$(md5sum ${2})
        checksumServer=$(sshpass -p ${1} ssh -o HostKeyAlgorithms=+ssh-rsa -o StrictHostKeyChecking=no -o CheckHostIP=no -p ${portSelected} ${3}@${4} md5sum ${5} 2> /dev/null)
        OUTPUT=$?
      fi
    fi
    if (( OUTPUT != 0 )) ; then
      print "Failed to get checksum for ${5}"
      print "Retrying..."
      sleep 5
      countChecksum=$(expr ${countChecksum} + 1)
      if (( countChecksum == 3 )) ; then
        correct=1
      fi
    else
      if [[ "${selectedTool}" == "rsync-e" ]] ; then
        print > /dev/null
        correct=1
      elif [[ "${selectedTool}" == "scp-e" ]] ; then
        print > /dev/null
        correct=1
      else
      print "Local checksum: ${checksumLocal}"
      print "Server checksum: ${checksumServer}"
      correct=1
      fi
    fi
  done
}

# Generate random codes 
generate_codes() {
  chars=("abcdefghijklmnopqrstywxz1234567890ABCDEFHIJKLMNOPQRSTYWXZ@/")
  long_code=("${1}")
  for i in {1} ; do
    print -n "${chars:RANDOM%${#chars}:1}"
  done
}

# Function to encrypt pass on config file
# Syntax: encrypt_kstools <password>
encrypt_kstools() {
  raw_pass=("${1}")
  characters_pass_raw=$(print ${raw_pass} | wc -m)
  characters_pass=$(expr ${characters_pass_raw} - 1)
  total_characters=0
  mkdir -p ${HOME}/.ks-tools/
  rm -rf ${HOME}/.ks-tools/.seq-codes
  while (( total_characters <= characters_pass )) ; do
    num_gen=$(print -n ${RANDOM} | cut -c1)
    print -n ${num_gen} >> ${HOME}/.ks-tools/.seq-codes
    total_characters=$(expr ${total_characters} + 1)
  done
  characters_seq_raw=$(cat ${HOME}/.ks-tools/.seq-codes 2> /dev/null | wc -m)
  characters_seq=$(expr ${characters_seq_raw} - 1)
  total_characters=1
  encrypted_pass=()
  while (( total_characters <= characters_pass )) ; do
    num_seq_read=$(cat ${HOME}/.ks-tools/.seq-codes 2> /dev/null | cut -c${total_characters})
    character=$(print ${raw_pass} | cut -c${total_characters})
    repeat_seq=0
    while (( repeat_seq < num_seq_read )) ; do
      code_gen=$(generate_codes)
      encrypted_pass=("${encrypted_pass}${code_gen}")
      repeat_seq=$(expr ${repeat_seq} + 1)
    done
    encrypted_pass=("${encrypted_pass}${character}")
    total_characters=$(expr ${total_characters} + 1)
  done
  code_gen=$(generate_codes)
  encrypted_pass=("${encrypted_pass}${code_gen}")
  print ${encrypted_pass}
}

# Function to decrypt pass on config file
# Syntax: decrypt_kstools <password>
decrypt_kstools() {
  raw_pass_encrypted=("${1}")
  total_characters=1
  codes_seq=$(cat ${HOME}/.ks-tools/.seq-codes 2> /dev/null)
  num_codes_seq=$(cat ${HOME}/.ks-tools/.seq-codes 2> /dev/null | wc -m)
  pass_decrypt=()  total_characters=1
  pos_codes_pass=0
  while (( total_characters < num_codes_seq )) ; do
    pos_codes=$(print ${codes_seq} | cut -c${total_characters})
    pos_codes_pass=$(expr ${pos_codes_pass} + ${pos_codes} + 1)
    pos_pass=$(expr ${raw_pass_encrypted} | cut -c${pos_codes_pass})
    pass_decrypt=("${pass_decrypt}${pos_pass}")
    total_characters=$(expr ${total_characters} + 1)
  done
  print ${pass_decrypt}
}

# Function to generate certificate on remote machine
gen_pem_ssh() {
  userhost=("${USER}")
  name_host=("${HOSTNAME}")
  print "" && print "* Generating .pem file to connect to this machine (${userhost})."
  print "${userhost}\n\n\n" | ssh-keygen
  mv ${userhost} ${userhost}-${name_host}.pem
  mkdir -p ~/.ssh
  chmod 700 ~/.ssh
  touch ~/.ssh/authorized_keys
  chmod 600  ~/.ssh/authorized_keys
  print "* Adding entry in the file ~/.ssh/authorized_keys"
  cat ${userhost}.pub >> ~/.ssh/authorized_keys
  rm -rf ${userhost}.pub
  print ""
  print "+ Copy the ${userhost}-${name_host}.pem file to your computer to connect to this machine."
  if [[ -f /usr/bin/puttygen ]] ; then
    puttygen ${userhost}-${name_host}.pem -o ${userhost}-${name_host}.ppk -O private
    print "+ Copy the ${userhost}-${name_host}.ppk file to your computer to connect to this machine."
  fi
  print "+ Connect: ssh -i ${userhost}-${name_host}.pem ${userhost}@${name_host}"
  print ""
}

# Function to show config
showConfig() {
  configAvailable=0
  print ""
  print -P "* %Bks-upv%b (ks-tools) %Bv${VERSION}%b (${M_DATE})"
  print ""
  if [[ -f ${dirConfig}/ks-upload-user ]] ; then
    showUser=$(cat ${dirConfig}/ks-upload-user)
    print "\- Server User: ${showUser}"
    configAvailable=1
  fi
  if [[ -f ${dirConfig}/ks-upload-pass ]] ; then
    readPasswordEncrypted=$(cat ${dirConfig}/ks-upload-pass)
    readPasswordDecrypted=$(decrypt_kstools "${readPasswordEncrypted}")
    readPasswordChars=$(print ${readPasswordDecrypted} | wc -m)
    totalchars=0
    showPassword=()
    while (( totalchars < readPasswordChars )) ; do
      showPassword=("${showPassword}*")
      totalchars=$(expr ${totalchars} + 1)
    done
    print "\- Server Password/PEM: ${showPassword}"
    configAvailable=1
  fi
  if [[ -f ${dirConfig}/ks-upload-server ]] ; then
    showServer=$(cat ${dirConfig}/ks-upload-server)
    print "\- URL (or IP) Server: ${showServer}"
    configAvailable=1
  fi
  if [[ -f ${dirConfig}/ks-upload-dirserver ]] ; then
    showDirServer=$(cat ${dirConfig}/ks-upload-dirserver)
    print "\- Destination Path (Server): ${showDirServer}"
    configAvailable=1
  fi
  if [[ -f ${dirConfig}/ks-upload-dirlocal ]] ; then
    showDirLocal=$(cat ${dirConfig}/ks-upload-dirlocal)
    print "\- Scan Path (Local): ${showDirLocal}"
    configAvailable=1
  fi
  if [[ -f ${dirConfig}/ks-upload-tool ]] ; then
    showUpvTool=$(cat ${dirConfig}/ks-upload-tool)
    print "\- Upload Tool: ${showUpvTool}"
    configAvailable=1
  fi
  if [[ -f ${dirConfig}/ks-upload-port ]] ; then
    showUpvPort=$(cat ${dirConfig}/ks-upload-port)
    print "\- Port Connection: ${showUpvPort}"
    configAvailable=1
  fi
  if (( configAvailable == 0 )) ; then
    print "* The configuration file does not exist!"
  fi
  print ""
  exit
}

