    rm -rf ${dirConfig}/ks-upload-dirlocal
    print "* Removed all configuration"
    rm -rf ${dirConfig}/ks-upload-tool
    rm -rf ${dirConfig}/ks-upload-port 
    print ""
    exit
  else
    print ""
    print "+ Remove configuration canceled"
    print ""
    exit
  fi
fi
# Show configuration file
if [[ "${1}" == "-c" ]] ; then
  showConfig
  # Edit configuration file
elif [[ "${1}" == "-e" ]] ; then
  editConfig
  # Show the version
elif [[ "${1}" == "-v" ]] ; then
  showVersion
  # Generate certificate
elif [[ "${1}" == "-p" ]] ; then
  gen_pem_ssh
  # Show the help
elif [[ "${1}" == "-h" ]] ; then
  showHelp
  # Create config
elif [[ "${1}" == "-g" ]] ; then
  createConfig
  # Init
elif [[ "${1}" == "-i" ]] ; then
  # Start script
  createConfig
  user=$(cat ${dirConfig}/ks-upload-user)
  raw_password=$(cat ${dirConfig}/ks-upload-pass)
  password=$(decrypt_kstools "${raw_password}")
  server=$(cat ${dirConfig}/ks-upload-server)
  dirServer=$(cat ${dirConfig}/ks-upload-dirserver)
  dirLocal=$(cat ${dirConfig}/ks-upload-dirlocal)
  # Call the functions to perform the whole process.
  print -P -n "* Scanning %U${dirLocal}%u "
  print ""
  if [[ -d ${dirLocal} ]] ; then
    listArchives "${dirLocal}"
    totalFiles=$(countArchives)
    count=1
    print "+ ${totalFiles} video file(s) found!"
    print ""
    current_tool=$(cat ${dirConfig}/ks-upload-tool)
    if [[ "${current_tool}" == "scp" ]] ; then
      print "* NOTE: You are using 'scp' to upload files and no progress will be shown."
      print "* IMPORTANT: It's possible switch to 'rsync' or 'scp-e' if you wish (Command: ks-upv -e)"
      print ""
    fi
    if [[ "${current_tool}" == "scp-rsa" ]] ; then
      print "* NOTE: You are using 'scp-rsa' to upload files and no progress will be shown."
      print "* IMPORTANT: It's possible switch to 'rsync-rsa' if you wish (Command: ks-upv -e)"
      print ""
    fi
    while (( count <= totalFiles )) ; do
      fullNameFile=$(showFile ${count})
      fullPathFile=$(showPathFile ${count})
      print -P "%BUploading%b %U${fullNameFile}%u "
      sendFile ${password} ${fullPathFile} ${user} ${server} ${dirServer} ${fullNameFile}
      if [[ "${current_tool}" == "scp-e" ]] ; then
        print > /dev/null
      elif [[ "${current_tool}" == "rsync-e" ]] ; then
        print > /dev/null
      else
        checkChecksum ${password} ${fullPathFile} ${user} ${server} ${dirServer}/${fullNameFile}
      fi
      print ""
      count=$(expr ${count} + 1)
    done
  else
    print "* Directory ${dirLocal} does not exist!"
    print ""
    exit
  fi
  # Show help
else
  showHelp
fi
