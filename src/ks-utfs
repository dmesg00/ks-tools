#!/usr/bin/env zsh

setopt NO_NOMATCH

#############################################################################
# ks-utfs (ks-tools) - Patch UTF-8 subtitles files replacing bad characters #
# Date: 25-08-2026                                                          #
# Author: dmesg00                                                           #
# Contact: dmesg00@duck.com                                                 #
#############################################################################
VERSION=("9.5")
M_DATE=("250826")

# Check cygwin alias (for Windows)
if [[ -f "/usr/bin/cygwin-alias.zsh" ]] ; then
  setopt ALIASES
  cygwin=("yes")
  source "/usr/bin/cygwin-alias.zsh"
else
  cygwin=("no")
fi

# Function for check dependencies
check_dependencies() {
  which_dependence=$(which ${1})
  error_dependence=$?
  if [[ -z "${which_dependence}" ]] || (( ${error_dependence} > 0 )); then
    print ""
    print -P "* %Bks-utfs%b (ks-tools) %Bv${VERSION}%b (${M_DATE})"
    print ""
    print -P "* %BDependency not found%b: %U${1}%u"
    print ""
    exit 1
  fi 
}

# Check dependencies
dependencies=(grep sed cut)
for scan_dependency in "${dependencies[@]}" ; do
  check_dependencies "${scan_dependency}"
done

# Show help
show_help() {
  print ""
  print -P "* %Bks-utfs%b (ks-tools) %Bv${VERSION}%b (${M_DATE})"
  print ""
  print "\- Patch UTF-8 subtitles file(s) replacing bad characters"
  print ""
  print -P "+ %USyntax%u: "
  print ""
  if [[ "${cygwin}" == "yes" ]] ; then
    print -P "  $ %Bks-utfs%b <relative/path/subtitle.srt>"
    print ""
    print -P " + Example: %Bks-utfs%b movies/Spiderman.srt"
    print ""
    print -P "* %UNote%u: %BIn Cygwin, you must use relative paths with this tool%b"
    print ""
  else
    print -P "  $ %Bks-utfs%b </absolute/path/subtitle.srt>"
    print ""
    print -P " + Example: %Bks-utfs%b /data/movies/Spiderman.srt"
    print ""
  fi
  exit
}

# Detect sed for Linux or MacOS
sed_i() {
  if [[ "$OSTYPE" == darwin* ]]; then
    sed -i '' "$@"
  else
    sed -i "$@"
  fi
}

