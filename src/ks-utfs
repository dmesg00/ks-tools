#############################################################################
VERSION="9.4"
M_DATE="140826"

# Check cygwin alias (for Windows)
if [[ -f "/usr/bin/cygwin-alias.zsh" ]] ; then
  setopt ALIASES
  cygwin="yes"
  source "/usr/bin/cygwin-alias.zsh"
else
  cygwin="no"
fi

# Function for check dependencies
check_dependencies() {
  which_dependence=$(which ${1})
  error_dependence=$?
  if [[ -z "${which_dependence}" ]] || (( ${error_dependence} > 0 )); then
    echo ""
    echo "* ks-utfs (ks-tools) v${VERSION} (${M_DATE})"
    echo ""
    echo "* Dependency not found: ${1}"
    echo ""
    exit 1
  fi 
}

# Check dependencies
dependencies="grep sed cut"
for scan_dependency in ${dependencies} ; do
  check_dependencies "${scan_dependency}"
done

# Show help
show_help() {
  echo ""
  echo "* ks-utfs (ks-tools) v${VERSION} (${M_DATE})"
  echo ""
  echo "- Patch UTF-8 subtitles file(s) replacing bad characters"
  echo ""
  echo "+ Syntax: "
  echo ""
  if [[ "${cygwin}" == "yes" ]] ; then
    echo "  $ ks-utfs <relative/path/subtitle.srt>"
    echo ""
    echo " + Example: ks-utfs movies/Spiderman.srt"
    echo ""
    echo "* Note: In Cygwin, you must use relative paths with this tool"
    echo ""
  else
    echo "  $ ks-utfs </absolute/path/subtitle.srt>"
    echo ""
    echo " + Example: ks-utfs /data/movies/Spiderman.srt"
    echo ""
  fi
  exit
}

