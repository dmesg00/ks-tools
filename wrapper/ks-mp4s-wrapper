    if [[ -z "${audio_default}" ]] ; then
      audio_default=("0:1")
    else
      audio_default_patch=$(print ${audio_default} | cut -c4)
      if [[ "${audio_default_patch}" == ":" ]] ; then
        audio_default=$(print ${audio_default} | cut -c1-3)
      else
        audio_default=("${audio_default}")
      fi
    fi
  else
    audio_default_patch=$(print ${audio_default} | cut -c4)
    if [[ "${audio_default_patch}" == ":" ]] ; then
      audio_default=$(print ${audio_default} | cut -c1-3)
    else
      audio_default=("${audio_default}")
    fi
  fi
  print "${audio_default}"
}

# Show the subtitle track default
