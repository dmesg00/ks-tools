        subtitle_default_patch=$(print ${subtitle_default} | cut -c4)
        if [[ "${subtitle_default_patch}" == ":" ]] ; then
          subtitle_default=$(print ${subtitle_default} | cut -c1-3)
        else
          subtitle_default=("${subtitle_default}")
        fi
